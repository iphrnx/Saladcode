# Supabase (required for Next.js + Edge Function calls)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: local Deno edge-function harness override (dev/test only)
# NEXT_PUBLIC_EDGE_BASE=http://localhost:8000/functions/v1

# Optional: direct Postgres URL for psql / reset scripts (must use verify-full TLS)
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_CA_CERT=/path/to/prod-ca-2021.crt

